>>> import numpy as np
>>> import fastcit

>>> # Each language makes its own random data, so the values differ from the other tabs.
>>> rng = np.random.default_rng(0)
>>> n = 200
>>> z = rng.standard_normal(n)
>>> x = z**2 + 0.5 * rng.standard_normal(n)  # nonlinear in Z
>>> y = z**2 + 0.5 * rng.standard_normal(n)
>>> data = fastcit.Dataset({
...     "X": ("continuous", x),
...     "Y": ("continuous", y),
...     "Z": ("continuous", z),
... })

>>> test = fastcit.KCI(data, bandwidth="median")
>>> result = test.run_test("X", "Y", ["Z"])
>>> result.statistic
9.425
>>> result.p_value
0.6176
>>> print(result.dof)
None
>>> result.effect_size
0.01423
