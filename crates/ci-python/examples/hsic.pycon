>>> import numpy as np
>>> import fastcit

>>> # Each language makes its own random data, so the values differ from the other tabs.
>>> rng = np.random.default_rng(0)
>>> n = 300
>>> x = rng.standard_normal(n)
>>> y = x**2 + 0.5 * rng.standard_normal(n)  # nonlinear dependence, zero correlation
>>> data = fastcit.Dataset({"X": ("continuous", x), "Y": ("continuous", y)})

>>> test = fastcit.HSIC(data, bandwidth="median")
>>> result = test.run_test("X", "Y")
>>> result.statistic
2629.3
>>> result.p_value
1.716e-42
>>> print(result.dof)
None
>>> result.effect_size
0.3072
