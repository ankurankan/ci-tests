>>> import numpy as np
>>> import fastcit

>>> # Each language makes its own random data, so the values differ from the other tabs.
>>> rng = np.random.default_rng(0)
>>> n = 2000
>>> z = rng.standard_normal(n)
>>> x = z + rng.standard_normal(n)  # X and Y depend on Z only
>>> y = z + rng.standard_normal(n)
>>> data = fastcit.Dataset({
...     "X": ("continuous", x),
...     "Y": ("continuous", y),
...     "Z": ("continuous", z),
... })

>>> # A small p-value supports equivalence: |rho| < threshold,
>>> # so X and Y are independent given Z.
>>> test = fastcit.PearsonEquivalence(data, delta_threshold=0.1)
>>> result = test.run_test("X", "Y", ["Z"])
>>> result.statistic
-0.01914
>>> result.p_value
0.0001431
>>> print(result.dof)
None
>>> result.effect_size
0.01914
