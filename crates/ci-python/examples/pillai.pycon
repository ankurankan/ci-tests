>>> import numpy as np
>>> import fastcit

>>> # Each language makes its own random data, so the values differ from the other tabs.
>>> rng = np.random.default_rng(0)
>>> n = 500
>>> z = rng.integers(0, 3, n)
>>> x = z + rng.standard_normal(n)  # continuous, driven by the discrete Z
>>> y = z + rng.standard_normal(n)
>>> data = fastcit.Dataset({
...     "X": ("continuous", x),
...     "Y": ("continuous", y),
...     "Z": ("discrete", z.astype(float)),
... })

>>> test = fastcit.PillaiTrace(data)
>>> result = test.run_test("X", "Y", ["Z"])
>>> result.statistic
0.0006621
>>> result.p_value
0.5660
>>> print(result.dof)
None
>>> result.effect_size
0.0006621
